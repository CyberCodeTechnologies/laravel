APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp

# Platform Settings
PLATFORM_FEE_PERCENTAGE=10.00
PLATFORM_MINIMUM_FEE=0
PLATFORM_MAXIMUM_FEE=0
PLATFORM_NAME="Panchi Gallery"
PLATFORM_CONTACT_EMAIL=support@panchigallery.com
PLATFORM_CONTACT_PHONE=

# Mail Configuration
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_TIMEOUT=30
MAIL_EHLO_DOMAIN=null
MAIL_FROM_ADDRESS="noreply@panchigallery.com"
MAIL_FROM_NAME="${APP_NAME}"

# Third-Party Email Services (Optional)
# Mailgun Configuration
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=

# Postmark Configuration
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=

# Resend Configuration
RESEND_API_KEY=

# Amazon SES Configuration
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Currency Configuration
DEFAULT_CURRENCY=USD
EXCHANGE_RATE_MMK=2100.0
AUTO_UPDATE_EXCHANGE_RATES=false
EXCHANGE_RATE_API=fixer
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_UPDATE_FREQUENCY=24
